# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Token Secrets (Generate 64+ char random strings for production)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_min_32_chars
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_min_32_chars

# ImageKit Configuration (Optional - fallback to local disk storage if omitted)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint

# Redis Caching (Optional - automatic in-memory / direct DB fallback if omitted)
REDIS_URL=redis://default:<password>@<host>:<port>

# Allowed Frontend URL for CORS (e.g., https://your-app.vercel.app or http://localhost:5173)
FRONTEND_URL=https://your-frontend.vercel.app
